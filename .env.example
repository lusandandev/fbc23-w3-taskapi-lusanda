# Copy this file to .env for local Docker Compose use. Never commit .env.
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=change-this-local-database-password
POSTGRES_DB=taskdb
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_PORT=8000

# Optional credentials for `docker compose exec api python -m scripts.seed`.
SEED_USER1_EMAIL=alice@example.com
SEED_USER1_PASSWORD=replace-with-a-local-seed-password-1
SEED_USER2_EMAIL=bob@example.com
SEED_USER2_PASSWORD=replace-with-a-local-seed-password-2
