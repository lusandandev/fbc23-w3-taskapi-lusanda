{
  "info": {
    "_postman_id": "a8c9a8aa-6c3e-4d75-8af0-4f29f9a52b2d",
    "name": "Task Tracker API - Week 3",
    "description": "Success and failure checks for the Week 3 Task Tracker API. Start the API with Docker Compose before running. The collection registers a fresh user and stores the token and task ID in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "test_email",
      "value": ""
    },
    {
      "key": "test_password",
      "value": "StrongPass123!"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "task_id",
      "value": ""
    },
    {
      "key": "second_email",
      "value": ""
    },
    {
      "key": "second_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health - database connected",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 when database is reachable', () => pm.response.to.have.status(200));",
              "pm.test('reports database connectivity', () => pm.expect(pm.response.json().database).to.eql('connected'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register - success",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/register",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('test_email', `week3-${Date.now()}@example.com`);",
              "pm.collectionVariables.set('test_password', pm.collectionVariables.get('test_password') || 'StrongPass123!');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('registers with 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('returns user details without password data', () => { pm.expect(body).to.have.property('id'); pm.expect(body).to.have.property('email'); pm.expect(body).not.to.have.property('password'); pm.expect(body).not.to.have.property('hashed_password'); });"
            ]
          }
        }
      ]
    },
